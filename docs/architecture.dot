digraph architecture {
  graph [fontname="Helvetica", rankdir=TB, splines=ortho, nodesep=0.5, ranksep=0.65, bgcolor="white", labelloc=t, fontsize=20, label="Stewardship Project A -- Infrastructure Modernisation (South Africa North)"];
  node [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", fontcolor="#1a1a1a"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];

  subgraph cluster_rg {
    label="Resource Group  (rg-stw-prod-southafricanorth)\nModule: 01-resource-group";
    style="filled,rounded";
    color="#888888";
    fillcolor="#f2f2f2";

    subgraph cluster_net {
      label="Networking";
      style="filled,rounded";
      color="#5b8ac0";
      fillcolor="#e8f0fa";

      vnet [label="Virtual Network\nvnet-stw-prod-southafricanorth\nModule: 02-vnet", fillcolor="#cfe0f5"];
      subnet [label="VM Subnet + NSG\nsnet-vm / nsg-vm\nModule: 03-subnets-nsg", fillcolor="#cfe0f5"];
      bastionsubnet [label="AzureBastionSubnet\nModule: 05-bastion", fillcolor="#cfe0f5"];
      pip [label="Public IP (reusable)\npip-bastion / pip-nat\nModule: 04-public-ip", fillcolor="#dcefe3"];
      bastion [label="Azure Bastion Host\nbas-stw-prod-southafricanorth\nModule: 05-bastion", fillcolor="#cfe0f5"];
      nat [label="NAT Gateway\nnat-stw-prod-southafricanorth\nModule: 06-nat-gateway", fillcolor="#cfe0f5"];

      vnet -> subnet;
      vnet -> bastionsubnet;
      pip -> bastion [label="public_ip_id"];
      pip -> nat [label="public_ip_id"];
      bastionsubnet -> bastion;
      subnet -> nat [label="subnet_id\n(outbound)"];
    }

    subgraph cluster_compute {
      label="Compute";
      style="filled,rounded";
      color="#c08a3e";
      fillcolor="#fbf1e2";

      nic [label="Network Interface\nnic-stw-prod-southafricanorth", fillcolor="#f6ddb5"];
      vm [label="Linux Virtual Machine\nvm-stw-prod-southafricanorth\nModule: 08-vm-nic", fillcolor="#f6ddb5"];
      disks [label="Data Disks\ndisk-stw-prod-...-dataNN\nModule: 09-data-disks", fillcolor="#f6ddb5"];

      subnet -> nic [label="subnet_id"];
      nic -> vm;
      vm -> disks [label="vm_id", dir=back];
    }

    subgraph cluster_monitoring {
      label="Storage & Monitoring";
      style="filled,rounded";
      color="#6f9e5c";
      fillcolor="#e9f4e3";

      storage [label="Storage Account + Container\nst<...> / con-syslog-...\nModule: 07-storage-account", fillcolor="#cfe8c4"];
      dcr [label="Data Collection Rule\n+ DCR Association\n+ AzureMonitorLinuxAgent\nModule: 10-monitoring-dcr", fillcolor="#cfe8c4"];

      vm -> dcr [label="vm_id\n(association + extension)"];
      storage -> dcr [label="storage_account_id\ncontainer_name", dir=back];
    }
  }

  operator [label="Platform Engineer", shape=ellipse, fillcolor="#eeeeee"];
  operator -> bastion [label="RDP/SSH over TLS 443"];
  bastion -> vm [label="private network hop"];

  legend [shape=note, fillcolor="#ffffff", fontsize=9, label="All resource names generated in module locals as\n<resource>-<project_name>-<environment>-<location>.\nAll modules composed and pinned to v1.0.0 in stw-infra-live.\nSyslog flow: VM -> AMA extension -> DCR -> Storage Account container."];
}
